	column expected_year_month_due_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: a5ff7b4c-3f86-47cd-8dba-2cf57a61ee05
		summarizeBy: none
		sourceColumn: expected_year_month_due_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column expected_year_month_start_date =
			
			VAR PrevDay = 'ventagium_projects'[expected_year_month_due_date] - 1
			RETURN
			DATE(
			    YEAR(PrevDay),
			    (QUARTER(PrevDay) - 1) * 3 + 1,
			    1
			)
		formatString: General Date
		lineageTag: a7aa7b08-d6bf-4c89-89b7-0ca686c27718
		summarizeBy: none

		variation Variation
			isDefault
			relationship: b552afb9-77ee-4c04-8df3-ce8344a0ccfd
			defaultHierarchy: LocalDateTable_5fbdd0d1-825d-4c13-8baf-2f7a59d3694c.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column dates_are_different = [expected_year_month_start_date] <> [expected_year_month_due_date]
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 75d346d3-c1aa-4bc7-9c3b-b6ed4e50f40b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

