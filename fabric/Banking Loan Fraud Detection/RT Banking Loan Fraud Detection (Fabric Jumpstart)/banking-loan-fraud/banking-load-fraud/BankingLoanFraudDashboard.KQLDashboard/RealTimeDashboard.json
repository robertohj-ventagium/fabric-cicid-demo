  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "bronze_banking\n| where timestamp between (_startTime .. _endTime)\n| summarize\n    Transactions = count(),\n    FraudTransactions = countif(is_fraud_suspected == true)\n    by country\n| extend FraudRate = round(100.0 * FraudTransactions / Transactions, 2)\n| order by FraudRate desc",
      "id": "f3a6204c-17c4-4e7e-a6c8-81486ac25698",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "bronze_banking\n| where timestamp between (_startTime .. _endTime)\n| summarize count() by browser\n\n",
      "id": "4382f9e4-51e0-4bea-b4df-b65cfffadc94",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "bronze_banking\n| where timestamp between (_startTime .. _endTime)\n| summarize count() by device_type\n\n",
      "id": "59b8b919-7e7b-4ad5-96bc-d5a00a992fef",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "// bronze_banking\n// | summarize count() by bin(timestamp, 10s)\n// | order by timestamp asc\n\nbronze_banking\n| where timestamp between (_startTime .. _endTime)\n| summarize count() by bin(timestamp, 10s)\n| order by timestamp asc\n\n",
      "id": "3dcd9bdd-759f-4341-92cf-1bdb74fd5c94",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "// Please enter your KQL query (Example):\n// bronze_banking\n// | count \n\n\nbronze_banking\n| where timestamp between (_startTime .. _endTime)\n| count",
      "id": "67cb6931-aaf4-4738-a66d-82e70cc55cb3",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "// Please enter your KQL query (Example):\n// bronze_banking\n// | where is_fraud_suspected == true \n// | count \n\nbronze_banking\n| where timestamp between (_startTime .. _endTime)\n| where is_fraud_suspected == true\n| count",
      "id": "49bc5b50-f6fa-409e-a7c0-7455e786acdf",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "// Please enter your KQL query (Example):\n// bronze_banking\n// | summarize\n//     TotalTransactions = count(),\n//     FraudTransactions = countif(is_fraud_suspected == true)\n// | extend FraudPercentage = round(100.0 * FraudTransactions / TotalTransactions, 2)\n// | project FraudPercentage\n\n\nbronze_banking\n| where timestamp between (_startTime .. _endTime)\n| summarize\n    TotalTransactions = count(),\n    FraudTransactions = countif(is_fraud_suspected == true)\n| extend FraudPercentage =\n    round(100.0 * FraudTransactions / TotalTransactions, 2)\n| project FraudPercentage",
      "id": "61e69491-5b09-4863-a017-b2346394cbc6",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "// Please enter your KQL query (Example):\n// bronze_banking\n// | summarize count() by status\n\nbronze_banking\n| where timestamp between (_startTime .. _endTime)\n| summarize count() by status",
      "id": "5aa1539b-f382-4ce7-a339-6dab79615217",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "bronze_banking\r\n| where timestamp between (_startTime .. _endTime)\r\n| summarize\r\n    TotalTransactions = count(),\r\n    FraudTransactions = countif(is_fraud_suspected == true)\r\n    by bin(timestamp, 10s)\r\n| extend FraudRate = round(100.0 * FraudTransactions / TotalTransactions, 2)\r\n| project timestamp, FraudRate\r\n| order by timestamp asc",
      "id": "e8ffad55-4483-4d27-9c60-fae34c4c2d2d",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "bronze_banking\r\n| where timestamp between (_startTime .. _endTime)\r\n| where is_fraud_suspected == true\r\n| mv-expand fraud_reasons\r\n| summarize FraudCount = count() by tostring(fraud_reasons)\r\n| order by FraudCount desc",
      "id": "524423ae-d9cf-488f-b77b-64b336cbcf10",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "0de5ae26-2290-4a0f-a6cf-4b684c470920"
      },
      "text": "bronze_banking\r\n| where timestamp between (_startTime .. _endTime)\r\n| summarize\r\n    Transactions = count(),\r\n    AvgLoanAmount = avg(loan_amount)\r\n    by status\r\n| order by AvgLoanAmount desc",
      "id": "e5f6617b-3569-4fbc-a525-27f0df25e7ef",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    }
