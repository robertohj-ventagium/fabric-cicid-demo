table batch_predictions
	lineageTag: 1adfd2bb-c499-495c-8a7b-7bb45c6fa7e6
	sourceLineageTag: [dbo].[batch_predictions]

	measure 'fraud percent' =
			
			DIVIDE(
			    [fraud transactions],
			    COUNTROWS(batch_predictions),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f1ef6a16-1b5e-4539-a136-2c7aaa77d372

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'fraud transactions' =
			
			CALCULATE(
			    COUNTROWS(batch_predictions),
			    batch_predictions[prediction] = 1
			)
		formatString: 0
		lineageTag: e17cce7c-2ce3-46b1-b686-acb7c147e1ae

		changedProperty = Name

