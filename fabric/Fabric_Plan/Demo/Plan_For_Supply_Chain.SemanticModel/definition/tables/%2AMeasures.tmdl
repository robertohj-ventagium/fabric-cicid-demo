table *Measures
	lineageTag: e3e11625-4f63-454f-8175-6bc213c9fa74

	measure 'Forecast Quantity' =
			
			SUM ( fact_forecast[ForecastQuantity] )
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 24e5a861-eb2f-433f-9d96-4a2d7ec87313

		annotation PBI_FormatHint = {"currencyCulture":"es"}

	measure 'Actual Sales' =
			
			SUM ( fact_actual_sales[ActualQuantity] )
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: d1827747-b7c2-48b7-baeb-c6eb10c96311

		annotation PBI_FormatHint = {"currencyCulture":"es"}

	measure 'Adjusted Forecast' =
			
			[Forecast Qty v1] * ( 1 + COALESCE ( SUM ( fact_promotion_uplift[UpliftPct] ), 0 ) )
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 3b8a98e8-99f2-4465-8ae8-518e4d5c7d20

		annotation PBI_FormatHint = {"currencyCulture":"es"}

	measure 'Forecast Adjustment' =
			
			[Adjusted Forecast] - [Forecast Quantity]
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: a7103201-a2c2-4403-b60e-d607a3d29ab6

		annotation PBI_FormatHint = {"currencyCulture":"es"}

	measure 'Forecast Adjustment %' =
			
			DIVIDE ( [Forecast Adjustment], [Forecast Quantity] )
		lineageTag: 4007aa3b-ce82-4cf0-a149-3d267bbdd7e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Actual vs Adjusted Forecast' =
			
			[Actual Sales] - [Adjusted Forecast]
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: eb561a08-1dd3-4507-a09c-c86c8d3a9470

		annotation PBI_FormatHint = {"currencyCulture":"es"}

	measure 'Actual vs Adjusted Forecast %' =
			
			DIVIDE ( [Actual Sales] - [Adjusted Forecast], [Actual Sales] )
		lineageTag: 8055a633-fd9a-40cd-bf8c-e44c6600f4da

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Qty v1' =
			
			CALCULATE(
			    SUM(fact_forecast[ForecastQuantity]),
			    fact_forecast[ForecastVersionID] = 1
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 236b3d35-b333-4532-ae25-7481a7b2938c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Forecast Qty v2' =
			
			CALCULATE(
			    SUM(fact_forecast[ForecastQuantity]),
			    fact_forecast[ForecastVersionID] = 2
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 4e02b216-edff-4e7e-a68b-aba67a339298

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Measure
		lineageTag: d6dc59d4-60d2-44de-9708-b00d2872aa0f

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Variance %' =
			
			DIVIDE(
			    [Actual Sales] - [Forecast Qty v1],
			    [Forecast Qty v1]
			)
		lineageTag: e613df36-e461-4c3d-8c5a-fb387429a23c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Actual or Forecast Qty' =
			
			COALESCE (
			    SUM ( fact_actual_sales[ActualQuantity] ),
			    [Forecast Qty v1]
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 0e488b8a-12cc-494b-b0e2-3bf8c163ce5c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Future Forecast Qty' =
			
			CALCULATE (
			    SUM ( fact_forecast[ForecastQuantity] ),
			    fact_forecast[ForecastVersionID] = 1,
			    dim_date[WeeksFromToday] >= 1
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 47f6b717-f583-45f8-9a04-3135a5d3861f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Value
		formatString: 0
		lineageTag: e4e790e6-7205-49b6-8a03-e3977649b583
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition *Measures = calculated
		mode: import
		source = {0}

	annotation PBI_Id = 085dd5b0efb04b3caf0ddcf518136ac9

