table DimAccount
	lineageTag: bf380fc0-4c54-4229-be83-20df03e796a7
	sourceLineageTag: [dbo].[DimAccount]

	measure 'Actuals Amount' =
			
			VAR Positive =
			    CALCULATE(
			        SUM(FactFinance[Amount]),
			        DimAccount[Operator] = "+"
			    )
			VAR Negative =
			    CALCULATE(
			        SUM(FactFinance[Amount]),
			        DimAccount[Operator] = "-"
			    )
			RETURN
			    Positive - Negative
		lineageTag: 6dcf5956-f267-42d4-bb28-68a0f3c1c0be

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

