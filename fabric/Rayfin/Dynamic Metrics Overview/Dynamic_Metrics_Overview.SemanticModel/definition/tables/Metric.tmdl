table Metric
	lineageTag: 4a4d888a-d9f8-4a39-a863-3c6f99c282c6
	sourceLineageTag: [dbo].[Metric]

	measure 'Current Value' =
			
			VAR LatestDate = MAX ( 'MetricValue'[Date] )
			RETURN
			    CALCULATE ( SUM ( 'MetricValue'[Value] ), 'MetricValue'[Date] = LatestDate )
		lineageTag: 747597ca-3a0a-41ea-9ad1-6d6233227b75

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Target Value' = SELECTEDVALUE ( 'Metric'[TargetValue] )
		lineageTag: 3e6658b6-e3a0-4a4a-b71b-37f576edf444

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Variance = [Current Value] - [Target Value]
		lineageTag: 81019463-41d5-4f06-92a1-7a630f5f0411

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variance %' = DIVIDE ( [Variance], [Target Value] )    -- format: 0.0%
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 67b59909-095a-4bd6-bd9e-ff9b5ca734fd

		changedProperty = Name

		changedProperty = FormatString

