table CreditProfiles
	lineageTag: db222e88-8224-4400-be77-67d21f14c0b8
	sourceLineageTag: [dbo].[CreditProfiles]

	measure d = SUM(CreditProfiles[DelinquenciesLast12Months])
		formatString: 0
		lineageTag: a68c7cb1-26a1-4663-bef5-3621a32d32f3

		changedProperty = Name

	measure cs =
			
			VAR score = sum(CreditProfiles[CreditScore])
			RETURN
			    IF(
			        score <= 580,
			        3,
			        IF(
			            score <= 670,
			            2,
			            1
			        )
			    )
		formatString: 0
		lineageTag: 39c969f2-00cf-41b6-81ab-b15e89515f8e

		changedProperty = Name

