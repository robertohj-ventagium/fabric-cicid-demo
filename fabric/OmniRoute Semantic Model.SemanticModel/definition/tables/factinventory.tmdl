table factinventory
	lineageTag: d85ca058-0472-4c5d-a8a1-12911fe33d08
	sourceLineageTag: [dbo].[factinventory]

	measure 'Total Inventory Value' =
			
			SUM(FactInventory[InventoryValue])
		lineageTag: 675aabed-f1de-4cec-aa58-de151321d9b4

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Units On Hand' =
			
			SUM(FactInventory[QuantityOnHand])
		formatString: 0
		lineageTag: 68dfdee4-f3df-429d-bf17-613285660843

		changedProperty = Name

	measure Stockouts =
			
			SUM(FactInventory[StockoutFlag])
		formatString: 0
		lineageTag: 58082ed1-eed2-45d8-9353-8a46b4621bd2

		changedProperty = Name

	measure 'Below Reorder Point' =
			
			COUNTROWS(
			    FILTER(
			        FactInventory,
			        FactInventory[QuantityOnHand] < FactInventory[ReorderPoint]
			    )
			)
		formatString: 0
		lineageTag: 9cda7658-017f-4271-9146-c775f9fdf4cb

		changedProperty = Name

	measure 'Average Supplier Reliability' =
			
			AVERAGE(DimSupplier[ReliabilityPct])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f1a62480-56e1-4930-82c8-14cd917a2c56

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Safety Stock Units' =
			
			SUM(FactInventory[SafetyStock])
		formatString: 0
		lineageTag: ad8f0461-f006-4c34-b4af-b515427c7cbb

		changedProperty = Name

