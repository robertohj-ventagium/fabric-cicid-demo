model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - Supply_Chain_Lakehouse"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb"]

ref table daily_supply_chain_snapshot
ref table orders
ref table port_disruptions
ref table container_status
ref table supplier_updates
ref table calendar
ref table emails
ref table kpis_daily
ref table inventory_daily
ref table weather

